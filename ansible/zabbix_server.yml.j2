services:
  zabbix-db:
    image: mirror.gcr.io/postgres:14-alpine
    container_name: zabbix-db
    environment:
      - POSTGRES_DB=zabbix
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_password
    volumes:
      - zabbix_db_data:/var/lib/postgresql/data
    restart: always

  zabbix-server:
    image: mirror.gcr.io/zabbix/zabbix-server-pgsql:ubuntu-7.0-latest
    container_name: zabbix-server
    environment:
      - DB_SERVER_HOST=zabbix-db
      - DB_SERVER_PORT=5432
      - POSTGRES_DB=zabbix
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_password
    ports:
      - "10051:10051"
    depends_on:
      - zabbix-db
    restart: always

  zabbix-web:
    image: mirror.gcr.io/zabbix/zabbix-web-nginx-pgsql:ubuntu-7.0-latest
    container_name: zabbix-web
    environment:
      - ZBX_SERVER_HOST=zabbix-server
      - DB_SERVER_HOST=zabbix-db
      - POSTGRES_DB=zabbix
      - POSTGRES_USER=zabbix
      - POSTGRES_PASSWORD=zabbix_password
    ports:
      - "80:8080"
    depends_on:
      - zabbix-db
      - zabbix-server
    restart: always

volumes:
  zabbix_db_data: